# ----------------------------
# Backend
# ----------------------------
APP_ENV=development
APP_DEBUG=false

# Database (Neon/Supabase/Postgres example)
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require

# CORS (comma-separated frontend origins)
FRONTEND_ORIGINS=http://localhost:5173

# Auth / crypto secrets
JWT_SECRET=<replace-with-strong-random-secret>
JWT_ALGORITHM=HS256
DATA_ENCRYPTION_KEY=<replace-with-strong-random-secret>

# Google OAuth (backend verification)
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Optional external APIs
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1
FACT_CHECK_API_KEY=<fact-check-api-key>

# HTTP / cookie security
ENFORCE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HSTS_MAX_AGE=31536000
MAX_REQUEST_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=20
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Abuse/rate limits
PUBLIC_RATE_LIMIT_PER_MINUTE=60
PUBLIC_DEVICE_LIMIT_PER_MINUTE=30
OTP_EMAIL_LIMIT_PER_10_MINUTES=3
OTP_IP_LIMIT_PER_10_MINUTES=10
OTP_MAX_ATTEMPTS=5
CAPTCHA_ABUSE_THRESHOLD=2
CAPTCHA_FREE_ABUSE_THRESHOLD=2

# CAPTCHA (optional)
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_BYPASS_TOKEN=

# SMTP (OTP email)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=<from-email>
SMTP_FROM_NAME=SachLens
OTP_EMAIL_SUBJECT=Your SachLens OTP Code

# Upload safety
CLAMAV_SCAN_COMMAND=clamscan
ALLOW_UNSCANNED_UPLOADS=false
UPLOAD_DIR=./uploads
UPLOAD_TTL_HOURS=24
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_BYTES=5242880

# ----------------------------
# Frontend (Vite)
# ----------------------------
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>
VITE_CAPTCHA_PROVIDER=
VITE_CAPTCHA_SITE_KEY=
